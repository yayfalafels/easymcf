[
  {"name": "protected route without a session", "method": "GET", "path": "/api/v1/track/search", "expected_status": 401},
  {"name": "health stays open", "method": "GET", "path": "/api/v1/health", "expected_status": 200},
  {"name": "sign up returns the user, no hash, and a cookie", "method": "POST", "path": "/api/v1/auth/signup",
   "body": {"name": "Casey Case", "email": "casey@example.test", "password": "Correct-Horse-9!"}, "expected_status": 201,
   "expected_cookie": {"name": "easymcf_session", "http_only": true}},
  {"name": "duplicate email is refused whatever its case", "method": "POST", "path": "/api/v1/auth/signup",
   "body": {"name": "Casey Two", "email": "CASEY@example.test", "password": "Correct-Horse-9!"}, "expected_status": 409},
  {"name": "malformed email is a 400", "method": "POST", "path": "/api/v1/auth/signup",
   "body": {"name": "Casey Three", "email": "not-an-email", "password": "Correct-Horse-9!"}, "expected_status": 400},
  {"name": "a password that breaks the policy is a 400 listing every rule", "method": "POST", "path": "/api/v1/auth/signup",
   "body": {"name": "Casey Four", "email": "casey4@example.test", "password": "short"}, "expected_status": 400,
   "expected_body": {"error": "validation_error", "field": "password", "message": "Password does not meet the requirements.",
                     "rules": ["too_short", "no_uppercase", "no_digit", "no_symbol"]}},
  {"name": "current user after sign up", "method": "GET", "path": "/api/v1/auth/me", "expected_status": 200,
   "expected_body": {"id": 3, "name": "Casey Case", "email": "casey@example.test", "photo_url": null, "auth_methods": ["password"]}},
  {"name": "sign out", "method": "POST", "path": "/api/v1/auth/signout", "expected_status": 204},
  {"name": "current user after sign out", "method": "GET", "path": "/api/v1/auth/me", "expected_status": 401},
  {"name": "wrong password gives the uniform 401", "method": "POST", "path": "/api/v1/auth/signin",
   "body": {"email": "casey@example.test", "password": "Wrong-Password-1!"}, "expected_status": 401,
   "expected_body": {"error": "invalid_credentials", "message": "Email or password is incorrect."}},
  {"name": "unknown email gives the same 401", "method": "POST", "path": "/api/v1/auth/signin",
   "body": {"email": "nobody@example.test", "password": "Wrong-Password-1!"}, "expected_status": 401,
   "expected_body": {"error": "invalid_credentials", "message": "Email or password is incorrect."}},
  {"name": "sign in sets a cookie", "method": "POST", "path": "/api/v1/auth/signin",
   "body": {"email": "casey@example.test", "password": "Correct-Horse-9!"}, "expected_status": 200,
   "expected_cookie": {"name": "easymcf_session", "http_only": true}},
  {"name": "current user after sign in", "method": "GET", "path": "/api/v1/auth/me", "expected_status": 200}
]
