  {"name": "text under a png name is refused", "as_user": "seed_a", "method": "PUT", "path": "/api/v1/users/1/photo", "files": {"photo": "tests/support/photo_fake.png"}, "expected_status": 415},
  {"name": "a jpeg is accepted", "as_user": "seed_a", "method": "PUT", "path": "/api/v1/users/1/photo", "files": {"photo": "tests/support/photo_wide.jpg"}, "expected_status": 200},
