[
  {"name": "signed out visit redirects to sign in", "route": "/leads",
   "actions": [{"op": "wait_for", "selector": "[data-testid=\"signin-submit\"]"}],
   "expect": [{"op": "url_path_equals", "value": "/signin"}]},
  {"name": "the sign in page has no user section", "route": "/signin",
   "actions": [{"op": "wait_for", "selector": "[data-testid=\"signin-submit\"]"}],
   "expect": [{"op": "count_equals", "selector": "[data-testid=\"user-section\"]", "value": 0}]},
  {"name": "a wrong password shows the uniform message", "route": "/signin",
   "actions": [{"op": "fill", "selector": "[data-testid=\"signin-email\"]", "value": "yayfalafels@gmail.com"},
               {"op": "fill", "selector": "[data-testid=\"signin-password\"]", "value": "Wrong-Password-1!"},
               {"op": "click", "selector": "[data-testid=\"signin-submit\"]"},
               {"op": "wait_for", "selector": "[data-testid=\"signin-error\"]"}],
   "expect": [{"op": "text_equals", "selector": "[data-testid=\"signin-error\"]", "value": "Email or password is incorrect."}]},
  {"name": "the sign up checklist marks a weak password", "route": "/signup",
   "actions": [{"op": "fill", "selector": "[data-testid=\"signup-password\"]", "value": "abc"}],
   "expect": [{"op": "attribute_equals", "selector": "[data-testid=\"signup-rule-no_lowercase\"]", "attribute": "data-state", "value": "met"},
              {"op": "attribute_equals", "selector": "[data-testid=\"signup-rule-too_short\"]", "attribute": "data-state", "value": "unmet"},
              {"op": "attribute_equals", "selector": "[data-testid=\"signup-rule-no_uppercase\"]", "attribute": "data-state", "value": "unmet"}]},
  {"name": "the user section shows once on leads", "as_user": "seed_a", "route": "/leads",
   "actions": [{"op": "wait_for", "selector": "[data-testid=\"user-avatar\"]"}],
   "expect": [{"op": "count_equals", "selector": "[data-testid=\"user-section\"]", "value": 1}]},
  {"name": "initials show when the user has no photo", "as_user": "seed_b", "route": "/tracks",
   "actions": [{"op": "wait_for", "selector": "[data-testid=\"user-avatar\"]"}],
   "expect": [{"op": "text_equals", "selector": "[data-testid=\"user-initials\"]", "value": "SS"}]},
  {"name": "log out returns to sign in", "as_user": "seed_a", "route": "/leads",
   "actions": [{"op": "click", "selector": "[data-testid=\"user-avatar\"]"},
               {"op": "click", "selector": "[data-testid=\"user-menu-logout\"]"},
               {"op": "wait_for", "selector": "[data-testid=\"signin-submit\"]"}],
   "expect": [{"op": "url_path_equals", "value": "/signin"}]}
]
