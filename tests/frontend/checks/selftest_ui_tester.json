[
  {
    "name": "selftest \u2014 leads column heading renders",
    "route": "/leads",
    "actions": [
      {
        "op": "wait_for",
        "selector": "[data-testid=\"leads-column-TOAPPLY\"] h2"
      }
    ],
    "expect": [
      {
        "op": "text_equals",
        "selector": "[data-testid=\"leads-column-TOAPPLY\"] h2",
        "value": "TOAPPLY"
      }
    ],
    "as_user": "seed_a"
  },
  {
    "name": "selftest \u2014 deliberately wrong expected heading text",
    "route": "/leads",
    "actions": [
      {
        "op": "wait_for",
        "selector": "[data-testid=\"leads-column-TOAPPLY\"] h2"
      }
    ],
    "expect": [
      {
        "op": "text_equals",
        "selector": "[data-testid=\"leads-column-TOAPPLY\"] h2",
        "value": "this text will never render"
      }
    ],
    "as_user": "seed_a"
  },
  {
    "name": "selftest \u2014 nonexistent selector times out",
    "route": "/leads",
    "actions": [
      {
        "op": "wait_for",
        "selector": "[data-testid=\"this-does-not-exist\"]",
        "timeout_ms": 2000
      }
    ],
    "expect": [],
    "as_user": "seed_a"
  }
]
